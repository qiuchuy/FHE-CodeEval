# Module-level constants derived from the circuit and input shapes
MULTIPLICATIVE_DEPTH = ...   # number of multiplicative levels needed
SCALING_MOD_SIZE     = ...   # bits per rescaling modulus
RING_DIM             = ...   # power-of-two ring dimension
N_SLOTS              = ...   # CKKS batch size
ROTATION_INDICES     = [...] # all rotations used in fhe_kernel
OUTPUT_SHAPE         = [...] # PyTorch output shape

def make_context():
    """Crypto context init: CCParamsCKKSRNS, GenCryptoContext, KeyGen,
    EvalMultKeyGen, EvalRotateKeyGen. Takes no arguments; all parameters
    come from module-level constants. Returns (cc, keys)."""
    parameters = openfhe.CCParamsCKKSRNS()
    parameters.SetMultiplicativeDepth(MULTIPLICATIVE_DEPTH)
    parameters.SetScalingModSize(SCALING_MOD_SIZE)
    parameters.SetScalingTechnique(openfhe.ScalingTechnique.FIXEDMANUAL)
    parameters.SetSecurityLevel(openfhe.HEStd_128_classic)
    parameters.SetRingDim(RING_DIM)
    parameters.SetBatchSize(N_SLOTS)
    cc = openfhe.GenCryptoContext(parameters)
    cc.Enable(openfhe.PKESchemeFeature.PKE)
    cc.Enable(openfhe.PKESchemeFeature.KEYSWITCH)
    cc.Enable(openfhe.PKESchemeFeature.LEVELEDSHE)
    cc.Enable(openfhe.PKESchemeFeature.ADVANCEDSHE)
    keys = cc.KeyGen()
    cc.EvalMultKeyGen(keys.secretKey)
    cc.EvalRotateKeyGen(keys.secretKey, ROTATION_INDICES)
    return cc, keys

def encrypt(cc, keys, arg1, arg2, ...):
    """Encode and encrypt inputs. The remaining arguments match the
    torch_kernel signature. Ciphertext-role inputs must be encrypted with
    cc.Encrypt; model weights and biases must be encoded as plaintexts with
    cc.MakeCKKSPackedPlaintext. Do not call model(x), model.forward(x), or run
    any part of a neural network forward pass inside encrypt()."""

def fhe_kernel(cc, keys, enc_inputs):
    """Core FHE computation only. This is the only wall-clock timed function.
    Do not perform crypto setup, encoding, encryption, decryption,
    Plaintext.GetRealPackedValue(), PyTorch, or NumPy computation here. Return
    openfhe.Ciphertext or list[openfhe.Ciphertext], never a torch.Tensor."""

def decrypt(cc, keys, ct_out):
    """Decrypt ct_out and return a torch.Tensor with the same shape and values,
    within tolerance, as the PyTorch reference output."""
```

- `make_context()` takes no arguments; put all circuit parameters in
